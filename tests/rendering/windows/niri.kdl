hotkey-overlay { skip-at-startup; }
layout {
    background-color "#242424"
    border { off; }
    focus-ring { off; }
}
window-rule {
    match app-id="^org[.]thing[.]render[.]windows$"
    open-floating true
    // keep the fixture away from output edges.
    default-floating-position x=32 y=32 relative-to="top-left"
}
